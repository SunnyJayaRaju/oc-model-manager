#!/usr/bin/env bash
# Backward compatibility shim for oc-session-backup

set -euo pipefail

# Source shared shim helpers
source "$(dirname "${BASH_SOURCE[0]}")/../lib/shim_helpers.sh"

case "${1:-}" in
  --help|-h)
    echo "usage: oc-session-backup <session_id> | --list | --restore <file.sql>"
    exit 0
    ;;
  --list)
    exec ocprobe session list
    ;;
  --restore)
    exec ocprobe session restore "$2"
    ;;
  "")
    echo "usage: oc-session-backup <session_id> | --list | --restore <file.sql>" >&2
    exit 1
    ;;
  *)
    exec ocprobe session backup "$1"
    ;;
esac