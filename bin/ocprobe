#!/usr/bin/env bash
# shellcheck shell=bash
# shellcheck disable=SC1091,SC2034
# ============================================================================
# ocprobe — OpenCode Model Probe (unified CLI)
# ============================================================================
set -euo pipefail

# ---- Bootstrap --------------------------------------------------------------
# Support both development (run from repo) and installed modes.
# Development: binary at <repo>/bin/ocprobe, lib/ at <repo>/lib/, VERSION at <repo>/VERSION
# Installed:   binary at ~/.local/bin/ocprobe, lib/ at ~/.local/lib/ocprobe/, VERSION at ~/.local/share/ocprobe/VERSION
OCPROBE_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Check for VERSION file alongside binary's parent (dev mode: repo/bin/ -> repo/VERSION)
if [[ -f "${OCPROBE_BIN_DIR}/../VERSION" ]]; then
    OCPROBE_ROOT="$(cd "${OCPROBE_BIN_DIR}/.." && pwd)"
    OCPROBE_LIB_DIR="${OCPROBE_ROOT}/lib"
    OCPROBE_CONFIG_DIR="${OCPROBE_ROOT}/config"
    OCPROBE_VERSION_FILE="${OCPROBE_ROOT}/VERSION"
else
    # Installed mode: binary at ~/.local/bin/ocprobe, lib/ at ~/.local/lib/ocprobe/, VERSION at ~/.local/share/ocprobe/VERSION
    OCPROBE_ROOT="${OCPROBE_BIN_DIR}/.."
    OCPROBE_LIB_DIR="${OCPROBE_ROOT}/lib/ocprobe"
    OCPROBE_CONFIG_DIR="${OCPROBE_ROOT}/share/ocprobe"
    OCPROBE_VERSION_FILE="${OCPROBE_ROOT}/share/ocprobe/VERSION"
fi
export OCPROBE_ROOT OCPROBE_LIB_DIR OCPROBE_CONFIG_DIR

# Load core library
source "${OCPROBE_LIB_DIR}/core.sh"
source "${OCPROBE_LIB_DIR}/config.sh"
source "${OCPROBE_LIB_DIR}/logging.sh"
source "${OCPROBE_LIB_DIR}/locking.sh"
source "${OCPROBE_LIB_DIR}/db.sh"

# ---- Version ----------------------------------------------------------------
OCPROBE_VERSION="$(cat "${OCPROBE_VERSION_FILE}")"

# ---- Help -------------------------------------------------------------------
usage() {
  cat <<'EOF'
ocprobe — OpenCode Model Probe

USAGE:
  ocprobe <command> [options]

COMMANDS:
  audit           Full cycle: diff → probe → confirm → apply (default)
  check           Dry-run only; exit 1 if changes pending
  status          Show whitelisted models + recent probe results
  alerts          Show recorded alerts [--clear]
  probe <model>   Test one model now
  watch           Run check+alert on interval (never auto-applies)
  validate        Probe all models for providers with credentials, blacklist failures
  scheduler       Manage launchd/systemd scheduler [install|uninstall|status]
  session         Session management [list|backup|restore|cleanup]
  config          Configuration [show|validate|edit|schema]
  doctor          Health check: config, DB, auth, disk
  version         Show version
  help            Show this help

GLOBAL OPTIONS:
  --quick         Skip whitelist probe (audit/check only)
  --force-refresh Force catalog refresh (ignore cache)
  --yes, -y       Assume yes to prompts
  --json          Output JSON (machine-readable)
  --config <path> Override config file
  --verbose, -v   Verbose logging
  --help, -h      Show help

ENVIRONMENT:
  OCPROBE_CONFIG         Config file path (default: ~/.config/ocprobe/config.yaml)
  OCPROBE_STATE_DIR      State directory (default: ~/.local/state/ocprobe)
  OCPROBE_LOG_LEVEL      Log level: debug, info, warn, error (default: info)
  OCPROBE_LOG_FORMAT     Log format: text, json (default: text)

EXAMPLES:
  ocprobe audit                    # Full audit with confirmation
  ocprobe check --quick            # Fast dry-run
  ocprobe status                   # Show whitelist + recent probes
  ocprobe alerts --clear           # Clear alert history
  ocprobe probe openrouter/gpt-4   # Test single model
  ocprobe watch                    # Continuous monitoring (6h interval)
  ocprobe validate                 # Dry-run: show what would be blacklisted
  ocprobe validate --apply         # Apply blacklist changes
  ocprobe validate --provider openrouter  # Validate single provider
  ocprobe validate restore         # Restore from last backup
  ocprobe scheduler install        # Install launchd timer (macOS)
  ocprobe session backup ses_abc   # Backup session to SQL
  ocprobe doctor                   # Health check

CONFIGURATION:
  See ocprobe config schema for full options.
  Example: ~/.config/ocprobe/config.yaml

EOF
}

# ---- Migration: copy old config if new doesn't exist --------------------------
migrate_config() {
  local old_config_dir="$HOME/.config/ocm"
  local new_config_dir="$HOME/.config/ocprobe"
  local old_config_file="$old_config_dir/config.yaml"
  local new_config_file="$new_config_dir/config.yaml"

  if [[ ! -d "$new_config_dir" && -f "$old_config_file" ]]; then
    mkdir -p "$new_config_dir"
    cp "$old_config_file" "$new_config_file"
    log_info "Migrated config from ~/.config/ocm/ to ~/.config/ocprobe/"
  fi
}

# ---- Command Dispatch -------------------------------------------------------
# Valid commands (subcommands) - used to identify where the subcommand is in the arg list
OCPROBE_COMMANDS=(
  audit check status alerts probe watch validate
  scheduler session config doctor version help
)

# Extract the subcommand from args (first non-flag argument)
# Returns the command name, or "help" if none found
extract_subcommand() {
  local args=("$@")
  for arg in "${args[@]}"; do
    if [[ "$arg" != -* ]]; then
      # Check if it's a valid command
      for cmd in "${OCPROBE_COMMANDS[@]}"; do
        if [[ "$arg" == "$cmd" ]]; then
          echo "$arg"
          return 0
        fi
      done
      # If it's not a flag but also not a valid command, it's probably a model name or similar
      # In that case, default to help (will show error)
      echo "help"
      return 0
    fi
  done
  echo "help"
}

# Parse global flags from ALL arguments, scanning through entire list
# The subcommand is identified and excluded from flag parsing but kept in remaining args

parse_global_flags() {
  local args=("$@")
  local subcmd="${args[-1]}"  # subcmd passed as last argument
  local args_len=${#args[@]}
  
  OCPROBE_QUICK=0
  OCPROBE_FORCE_REFRESH=0
  OCPROBE_ASSUME_YES=0
  OCPROBE_JSON_OUTPUT=0
  OCPROBE_VERBOSE=0
  OCPROBE_CONFIG_OVERRIDE=""
  OCPROBE_REMAINING_ARGS=()
  
  # Scan ALL args except the last one (which is subcmd)
  for ((i=0; i<args_len-1; i++)); do
    local arg="${args[i]}"
    
    case "$arg" in
      --quick) OCPROBE_QUICK=1 ;;
      --force-refresh) OCPROBE_FORCE_REFRESH=1 ;;
      --yes|-y) OCPROBE_ASSUME_YES=1 ;;
      --json) OCPROBE_JSON_OUTPUT=1 ;;
      --verbose|-v) OCPROBE_VERBOSE=1 ;;
      --config) 
        # Handle --config value in next iteration
        ((i++))
        if [[ $i -lt $((args_len-1)) ]]; then
          OCPROBE_CONFIG_OVERRIDE="${args[i]}"
        fi
        ;;
      --config=*) OCPROBE_CONFIG_OVERRIDE="${arg#*=}" ;;
      --help|-h) usage; exit 0 ;;
      --) break ;;
      -*) log_error "Unknown global flag: $arg"; exit 1 ;;
      *) 
        # Non-flag argument - add to remaining (including subcommand if it appears)
        OCPROBE_REMAINING_ARGS+=("$arg")
        ;;
    esac
  done
  
  # Finally, append the subcommand to remaining args (it belongs in the command position)
  OCPROBE_REMAINING_ARGS+=("$subcmd")
}

# ---- Command Dispatch -------------------------------------------------------
main() {
  local cmd="${1:-help}"
  shift || true

  # Run migration before loading config (migration doesn't depend on config)
  migrate_config

  case "$cmd" in
    audit|check|status|alerts|probe|watch|validate)
      source "${OCPROBE_LIB_DIR}/models.sh"
      source "${OCPROBE_LIB_DIR}/validate.sh"
      "cmd_${cmd}" "$@"
      ;;
    scheduler)
      source "${OCPROBE_LIB_DIR}/scheduler.sh"
      cmd_scheduler "$@"
      ;;
    session)
      source "${OCPROBE_LIB_DIR}/session.sh"
      cmd_session "$@"
      ;;
    config)
      source "${OCPROBE_LIB_DIR}/config.sh"
      cmd_config "$@"
      ;;
    doctor)
      source "${OCPROBE_LIB_DIR}/doctor.sh"
      cmd_doctor "$@"
      ;;
    version|--version|-V)
      echo "ocprobe ${OCPROBE_VERSION}"
      ;;
    help|--help|-h)
      usage
      ;;
    *)
      log_error "Unknown command: $cmd"
      usage
      exit 1
      ;;
  esac
}

# ---- Entry Point --------------------------------------------------------------
# Parse subcommand first (first non-flag arg)
subcmd=$(extract_subcommand "$@")

# Parse global flags from ALL args (pass subcmd as last arg for identification)
parse_global_flags "$@" "$subcmd"
init_logging

# Remaining args already contain subcommand in correct position
set -- "${OCPROBE_REMAINING_ARGS[@]}"
main "$@"