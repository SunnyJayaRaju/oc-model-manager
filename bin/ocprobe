#!/usr/bin/env bash
# shellcheck shell=bash
# shellcheck disable=SC1091,SC2034
# ============================================================================
# ocprobe — OpenCode Model Probe (unified CLI)
# ============================================================================
set -euo pipefail

# ---- Bootstrap --------------------------------------------------------------
OCPROBE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export OCPROBE_ROOT

# Load core library
source "${OCPROBE_ROOT}/lib/core.sh"
source "${OCPROBE_ROOT}/lib/config.sh"
source "${OCPROBE_ROOT}/lib/logging.sh"
source "${OCPROBE_ROOT}/lib/locking.sh"
source "${OCPROBE_ROOT}/lib/db.sh"

# ---- Version ----------------------------------------------------------------
OCPROBE_VERSION="$(cat "${OCPROBE_ROOT}/VERSION")"

# ---- Help -------------------------------------------------------------------
usage() {
  cat <<'EOF'
ocprobe — OpenCode Model Probe

USAGE:
  ocprobe <command> [options]

COMMANDS:
  audit           Full cycle: diff → probe → confirm → apply (default)
  check           Dry-run only; exit 1 if changes pending
  status          Show whitelisted models + recent probe results
  alerts          Show recorded alerts [--clear]
  probe <model>   Test one model now
  watch           Run check+alert on interval (never auto-applies)
  validate        Probe all models for providers with credentials, blacklist failures
  scheduler       Manage launchd/systemd scheduler [install|uninstall|status]
  session         Session management [list|backup|restore|cleanup]
  config          Configuration [show|validate|edit|schema]
  doctor          Health check: config, DB, auth, disk
  version         Show version
  help            Show this help

GLOBAL OPTIONS:
  --quick         Skip whitelist probe (audit/check only)
  --force-refresh Force catalog refresh (ignore cache)
  --yes, -y       Assume yes to prompts
  --json          Output JSON (machine-readable)
  --config <path> Override config file
  --verbose, -v   Verbose logging
  --help, -h      Show help

ENVIRONMENT:
  OCPROBE_CONFIG         Config file path (default: ~/.config/ocprobe/config.yaml)
  OCPROBE_STATE_DIR      State directory (default: ~/.local/state/ocprobe)
  OCPROBE_LOG_LEVEL      Log level: debug, info, warn, error (default: info)
  OCPROBE_LOG_FORMAT     Log format: text, json (default: text)

EXAMPLES:
  ocprobe audit                    # Full audit with confirmation
  ocprobe check --quick            # Fast dry-run
  ocprobe status                   # Show whitelist + recent probes
  ocprobe alerts --clear           # Clear alert history
  ocprobe probe openrouter/gpt-4   # Test single model
  ocprobe watch                    # Continuous monitoring (6h interval)
  ocprobe validate                 # Dry-run: show what would be blacklisted
  ocprobe validate --apply         # Apply blacklist changes
  ocprobe validate --provider openrouter  # Validate single provider
  ocprobe validate restore         # Restore from last backup
  ocprobe scheduler install        # Install launchd timer (macOS)
  ocprobe session backup ses_abc   # Backup session to SQL
  ocprobe doctor                   # Health check

CONFIGURATION:
  See ocprobe config schema for full options.
  Example: ~/.config/ocprobe/config.yaml

EOF
}

# ---- Migration: copy old config if new doesn't exist --------------------------
migrate_config() {
  local old_config_dir="$HOME/.config/ocm"
  local new_config_dir="$HOME/.config/ocprobe"
  local old_config_file="$old_config_dir/config.yaml"
  local new_config_file="$new_config_dir/config.yaml"

  if [[ ! -d "$new_config_dir" && -f "$old_config_file" ]]; then
    mkdir -p "$new_config_dir"
    cp "$old_config_file" "$new_config_file"
    log_info "Migrated config from ~/.config/ocm/ to ~/.config/ocprobe/"
  fi
}

# ---- Command Dispatch -------------------------------------------------------
main() {
  local cmd="${1:-help}"
  shift || true

  # Run migration before loading config (migration doesn't depend on config)
  migrate_config

  case "$cmd" in
    audit|check|status|alerts|probe|watch|validate)
      source "${OCPROBE_ROOT}/lib/models.sh"
      source "${OCPROBE_ROOT}/lib/validate.sh"
      "cmd_${cmd}" "$@"
      ;;
    scheduler)
      source "${OCPROBE_ROOT}/lib/scheduler.sh"
      cmd_scheduler "$@"
      ;;
    session)
      source "${OCPROBE_ROOT}/lib/session.sh"
      cmd_session "$@"
      ;;
    config)
      source "${OCPROBE_ROOT}/lib/config.sh"
      cmd_config "$@"
      ;;
    doctor)
      source "${OCPROBE_ROOT}/lib/doctor.sh"
      cmd_doctor "$@"
      ;;
    version|--version|-V)
      echo "ocprobe ${OCPROBE_VERSION}"
      ;;
    help|--help|-h)
      usage
      ;;
    *)
      log_error "Unknown command: $cmd"
      usage
      exit 1
      ;;
  esac
}

# ---- Global Flag Parsing ----------------------------------------------------
OCPROBE_QUICK=0
OCPROBE_FORCE_REFRESH=0
OCPROBE_ASSUME_YES=0
OCPROBE_JSON_OUTPUT=0
OCPROBE_VERBOSE=0
OCPROBE_CONFIG_OVERRIDE=""

parse_global_flags() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --quick) OCPROBE_QUICK=1 ;;
      --force-refresh) OCPROBE_FORCE_REFRESH=1 ;;
      --yes|-y) OCPROBE_ASSUME_YES=1 ;;
      --json) OCPROBE_JSON_OUTPUT=1 ;;
      --verbose|-v) OCPROBE_VERBOSE=1 ;;
      --config) OCPROBE_CONFIG_OVERRIDE="$2"; shift ;;
      --config=*) OCPROBE_CONFIG_OVERRIDE="${1#*=}" ;;
      --help|-h) usage; exit 0 ;;
      --) shift; break ;;
      -*) log_error "Unknown global flag: $1"; exit 1 ;;
      *) break ;;
    esac
    shift
  done
}

# Initialize logging early
parse_global_flags "$@"
init_logging

# Re-parse without global flags for command
set -- "${@}"  # remaining args after global flags
main "$@"