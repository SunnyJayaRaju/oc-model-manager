# Build output (generated fresh by the CI "build" job on every tagged release)
dist/

# OS junk
.DS_Store
Thumbs.db

# Editor backups/swap files
*~
*.swp
*.bak
*.orig

# Local config overrides / logs, if any get created during local testing
*.log

# ocm validate backups (defensive - default location outside repo)
validate-backups/
.opencode.json.backup-*
.serena/

# Secrets / credentials (never commit)
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
credentials*
auth.json
**/secrets.*

# Local state / runtime artifacts
.ocprobe/
*.sqlite
*.db

# Additional security patterns
.env.local
*.p12
*.pfx
opencode.json.ocprobe-backup-*
